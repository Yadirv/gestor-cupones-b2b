# Configuración del entorno para el Gestor de Cupones B2B
# Copia este archivo como .env y ajusta los valores según tu despliegue.

# ── Backend Supabase (Por tabla) ─────────────────────────────
SUPABASE_URL_CLIENTES_B2B=
SUPABASE_KEY_CLIENTES_B2B=
SUPABASE_URL_COD_CIUDADES=
SUPABASE_KEY_COD_CIUDADES=
SUPABASE_URL_COD_TIENDAS=
SUPABASE_KEY_COD_TIENDAS=
SUPABASE_URL_CUPONES_GENERADOS=
SUPABASE_KEY_CUPONES_GENERADOS=
SUPABASE_URL_CUPONES_RECLAMADOS=
SUPABASE_KEY_CUPONES_RECLAMADOS=
SUPABASE_URL_USUARIOS=
SUPABASE_KEY_USUARIOS=

# Configuración de Analytics (Chart.js)
# Habilitar o deshabilitar el renderizado de gráficos en el panel admin
VITE_ENABLE_ANALYTICS=true

# Configuración de entorno
# Valores: development, production
NODE_ENV=development

# Clave de API para servicios externos (si aplica)
# Ejemplo: API de WhatsApp Business o servicios de autenticación
VITE_API_KEY=tu_api_key_secreta_aqui

# Configuración de logs
# Valores: debug, info, warn, error
LOG_LEVEL=debug